[Unit]
Description=Service d'impression d'étiquettes Zebra
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zebra
WorkingDirectory=/opt/zebra-etiquettes
ExecStart=/usr/bin/npm run start
Environment=PORT=3000
Environment=DATA_DIR=/opt/zebra-etiquettes/data
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
